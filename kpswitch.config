
config switch 'main'
	option host 'kp-9000-9xhml-x.lan'
	option username 'admin'
	option password ''
	# 1 = "kpswitch apply" also saves to the switch's flash when it succeeds
	option autosave '0'
	# 1 = "kpswitch apply" deletes switch VLANs that are not listed here
	option prune '0'

# Run "kpswitch import -w" to fill in the port and vlan sections from the
# switch's current state. Shape of the sections:
#
# config vlan 'vlan10'
#	option vid '10'
#	option name 'LAN10'
#	list untagged '1'
#	list tagged '8'
#
# config port 'port1'
#	option port '1'
#	option enable '1'
#	option speed 'auto'      # auto 10h 10f 100h 100f 1000f 2500f (port 9: 10gf)
#	option flow '0'
#	option pvid '10'
#	option accept 'untagged' # all | tagged | untagged
